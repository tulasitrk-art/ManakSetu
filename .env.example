# Environment variables for is-recommender-system
PROJECT_NAME="AI-Powered Indian Standards Recommendation Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Backend CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Neo4j Settings (Optional / Fallback to in-memory graph)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=bis_standards_password

# Vector DB Settings
VECTOR_DB_URL=http://qdrant:6333

# Translation Service (Optional / Default uses built-in high-coverage domain dictionary)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
